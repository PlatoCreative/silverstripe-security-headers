{
  "name": "signify-nz/silverstripe-security-headers",
  "description": "Adds configurable security headers to HTTP responses via middleware.",
  "homepage": "https://github.com/signify-nz/silverstripe-security-headers",
  "keywords": [
    "silverstripe",
    "security",
    "headers",
    "report",
    "CSP"
  ],
  "type": "silverstripe-vendormodule",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Signify Ltd",
      "homepage": "https://www.signify.co.nz/"
    }
  ],
  "support": {
    "issues": "https://github.com/signify-nz/silverstripe-security-headers/issues"
  },
  "require": {
    "php": "^8.3",
    "silverstripe/vendor-plugin": "^3.0",
    "silverstripe/framework": "^6.0",
    "silverstripe/cms": "^6.0",
    "symbiote/silverstripe-queuedjobs": "^6.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0",
    "squizlabs/php_codesniffer": "^3.0"
  },
  "suggest": {
    "unclecheese/display-logic": "Provides functionality to hide filter fields that aren't active."
  },
  "extra": {
    "expose": [
      "client/dist"
    ]
  },
  "autoload": {
    "psr-4": {
      "Signify\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Signify\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "silverstripe/vendor-plugin": true
    }
  }
}
